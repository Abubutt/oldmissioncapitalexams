# Which provider generates adaptive exam questions: "anthropic", "ollama", or "openai".
LLM_PROVIDER=anthropic

# --- Anthropic (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=your-key-here

# Optional: override the model used for adaptive question generation.
# Defaults to claude-sonnet-4-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Ollama (LLM_PROVIDER=ollama) — free, local, runs on your machine ---
# Requires `ollama serve` running and the model already pulled
# (e.g. `ollama pull llama3`). See README for quality caveats: smaller local
# models are noticeably less reliable at getting the *answer key* right than
# a hosted model, not just at formatting JSON.
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192

# --- OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# Defaults to o4-mini if unset — a reasoning model, switched to from gpt-4o
# after it solved a harder discrete-math batch 8/8 vs. gpt-4o's 7/8 (see
# README "Study materials" / Discrete Math section). Costs more per question
# (hidden reasoning tokens bill at the output rate) but Discrete Math is now
# the largest section by weight, so correctness there matters more. Set this
# to whatever model your account/key actually has access to — a
# model-not-found error will tell you clearly if the default isn't available.
# OPENAI_MODEL=o4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- History store (per-user progress, keyed by the email entered at the gate) ---
# Leave unset for local dev — falls back to one JSON file per user under
# data/history/. Set both to persist across restarts/redeploys on a host with
# an ephemeral filesystem (most free tiers). Free forever, no card required —
# see README "Persistence" section for setup steps.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Access gate ---
# If set, every /api/* route except /api/gate-status and /api/login requires
# this code (sent by the frontend as an X-Access-Code header, or via the
# login screen it shows on first visit). Leave unset for open local dev.
# Required for any public deploy — otherwise anyone can spend your API key.
# ACCESS_CODE=choose-a-long-random-string

# Optional: override the port the server listens on (defaults to 3000).
# PORT=3000
